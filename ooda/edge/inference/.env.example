# OODA Inference Module Environment Configuration
# Copy this file to .env and customize as needed

# ============================================
# Video Capture Settings
# ============================================
# Video source: 0 for default camera, or path to file, or RTSP URL
OODA_VIDEO_SOURCE=0

# Video resolution
OODA_VIDEO_WIDTH=1920
OODA_VIDEO_HEIGHT=1080

# Frame rate
OODA_VIDEO_FPS=30

# Video codec: avc1 (H.264), mp4v (MPEG-4)
OODA_VIDEO_CODEC=avc1

# Duration of each video segment in seconds (default: 5 minutes)
OODA_SEGMENT_DURATION=300

# ============================================
# Inference Settings
# ============================================
# Enable/disable license plate inference
OODA_INFERENCE_ENABLED=true

# Process every Nth frame (30 = 1 frame per second at 30fps)
OODA_FRAME_INTERVAL=30

# Number of frames to process in each batch
OODA_BATCH_SIZE=4

# Minimum confidence for detections (0.0 - 1.0)
OODA_CONFIDENCE_THRESHOLD=0.5

# ============================================
# Storage Settings
# ============================================
# Directory for video recordings
OODA_RECORDING_DIR=/data/recordings

# Directory for videos ready to upload
OODA_BUFFER_DIR=/data/video_buffer

# Maximum storage for recordings (in GB)
OODA_MAX_STORAGE_GB=50.0

# Minimum free disk space to maintain (in GB)
OODA_MIN_FREE_SPACE_GB=5.0

# Automatically delete old files when storage is full
OODA_AUTO_CLEANUP=true

# Save inference detection results as JSON
OODA_SAVE_INFERENCE=true

# ============================================
# Logging Settings
# ============================================
# Log file path
OODA_LOG_FILE=/var/log/ooda/inference.log

# Log level: DEBUG, INFO, WARNING, ERROR
OODA_LOG_LEVEL=INFO

# ============================================
# Example Configurations
# ============================================

# Use USB camera
# OODA_VIDEO_SOURCE=/dev/video0

# Use RTSP stream
# OODA_VIDEO_SOURCE=rtsp://username:password@192.168.1.100:554/stream

# Use video file
# OODA_VIDEO_SOURCE=/path/to/video.mp4

# High performance (process more frames)
# OODA_FRAME_INTERVAL=10
# OODA_BATCH_SIZE=8

# Low performance (process fewer frames)
# OODA_FRAME_INTERVAL=60
# OODA_BATCH_SIZE=2

# Disable inference (recording only)
# OODA_INFERENCE_ENABLED=false
