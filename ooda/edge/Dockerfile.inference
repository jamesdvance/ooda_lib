# OODA Inference Module Dockerfile
# Lightweight container for video recording on Jetson Nano (ARM64)
# For GPU-accelerated inference, switch base to nvcr.io/nvidia/l4t-ml:r35.2.1-py3

FROM python:3.11-slim

# Install system dependencies for OpenCV video capture and encoding
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libv4l-dev \
    v4l-utils \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy requirements file
COPY inference/requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Create non-root user for security
RUN useradd -m -u 1000 ooda && \
    mkdir -p /data/video_buffer /data/recordings /var/log/ooda && \
    chown -R ooda:ooda /data /var/log/ooda

# Copy inference module
COPY --chown=ooda:ooda inference/ /app/

# Switch to non-root user
USER ooda

# Environment variables
ENV PYTHONUNBUFFERED=1 \
    OODA_RECORDING_DIR=/data/recordings \
    OODA_BUFFER_DIR=/data/video_buffer \
    OODA_LOG_FILE=/var/log/ooda/inference.log

# Expose volumes for shared data with uploader
VOLUME ["/data", "/var/log/ooda"]

# Health check
HEALTHCHECK --interval=1m --timeout=10s --start-period=30s --retries=3 \
    CMD python -c "import sys; sys.exit(0)"

# Default entrypoint - runs the inference/recording application
ENTRYPOINT ["python", "main.py"]
