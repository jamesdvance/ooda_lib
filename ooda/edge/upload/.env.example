# AWS credentials (use dummy values for local testing without S3)
AWS_ACCESS_KEY_ID=testing
AWS_SECRET_ACCESS_KEY=testing
AWS_DEFAULT_REGION=us-east-1

# S3 configuration
OODA_S3_BUCKET=test-bucket
OODA_S3_REGION=us-east-1

# Storage configuration
OODA_MAX_BUFFER_SIZE_GB=5

# Logging
OODA_LOG_LEVEL=DEBUG

# Upload schedule
OODA_UPLOAD_INTERVAL_HOURS=1

# Compression
OODA_COMPRESSION_ENABLED=true
OODA_COMPRESSION_CRF=28

# Batching
OODA_BATCHING_ENABLED=true
OODA_BATCH_WINDOW_HOURS=1
